-- 1. Create Database
CREATE DATABASE COMPANY;

-- 2. Use Database
USE COMPANY;

-- 3. Create Employee Table
CREATE TABLE EMPLOYEE (
    Emp_no INT PRIMARY KEY,
    E_name VARCHAR(50),
    E_address VARCHAR(100),
    E_ph_no VARCHAR(15),
    Dept_no INT,
    Dept_name VARCHAR(50),
    Job_id CHAR(10),
    Salary DECIMAL(10,2)
);

-- 4. Add New Column
ALTER TABLE EMPLOYEE ADD HIREDATE DATE;

-- 5. Modify Job_id Datatype
ALTER TABLE EMPLOYEE MODIFY Job_id VARCHAR(10);

-- 6. Rename Column
ALTER TABLE EMPLOYEE
RENAME COLUMN Emp_no TO E_no;

-- 7. Modify Column Width
ALTER TABLE EMPLOYEE MODIFY Job_id VARCHAR(20);

-- 8. Add Unique Constraint
ALTER TABLE EMPLOYEE
ADD CONSTRAINT UQ_E_ph_no UNIQUE (E_ph_no);

-- 9. Add Not Null Constraint
ALTER TABLE EMPLOYEE
MODIFY E_name VARCHAR(50) NOT NULL;

-- 10. Add Check Constraint
ALTER TABLE EMPLOYEE
ADD CONSTRAINT CHK_Salary CHECK (Salary > 0);

