-- 1. Display Authors
SELECT * FROM Authors;

-- 2. Display Books
SELECT * FROM Books;

-- 3. Display Borrowers
SELECT * FROM Borrowers;

-- 4. Display Book Borrowing
SELECT * FROM BookBorrowing;

-- 5. Books and Author Names using INNER JOIN
SELECT UPPER(b.Title) AS Title, a.Name AS Author
FROM Books b
INNER JOIN Authors a ON b.AuthorID = a.AuthorID;

-- 6. Number of Books Each Author Has Written
SELECT Name,
    (SELECT COUNT(*)
     FROM Books
     WHERE Books.AuthorID = Authors.AuthorID)
     AS NumberOfBooks
FROM Authors;

-- 7. Books Borrowed by John Doe
SELECT Title FROM Books
WHERE BookID IN (
    SELECT BookID
    FROM BookBorrowing
    WHERE BorrowerID = (
        SELECT BorrowerID
        FROM Borrowers
        WHERE Name = 'John Doe'
    )
);

-- 8. List All Books and Their Borrowers
SELECT
    b.Title,
    COALESCE(bb_data.Name, 'Not Borrowed') AS Borrower
FROM Books b
LEFT JOIN (
    SELECT bb.BookID, br.Name
    FROM BookBorrowing bb
    JOIN Borrowers br
    ON bb.BorrowerID = br.BorrowerID
) AS bb_data
ON b.BookID = bb_data.BookID;

-- 9. Borrowers Who Borrowed Books by J.K. Rowling
SELECT DISTINCT br.Name
FROM Borrowers br
WHERE EXISTS (
    SELECT 1
    FROM BookBorrowing bb
    JOIN Books b ON bb.BookID = b.BookID
    WHERE b.AuthorID = (
        SELECT AuthorID
        FROM Authors
        WHERE Name = 'J.K. Rowling'
    )
    AND bb.BorrowerID = br.BorrowerID
);

-- 10. Books That Have Been Borrowed
SELECT Title
FROM Books
WHERE EXISTS (
    SELECT 1
    FROM BookBorrowing bb
    WHERE bb.BookID = Books.BookID
);

-- 11. Books That Have Not Been Borrowed
SELECT Title
FROM Books
WHERE NOT EXISTS (
    SELECT 1
    FROM BookBorrowing bb
    WHERE bb.BookID = Books.BookID
);


